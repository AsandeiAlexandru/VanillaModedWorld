# ==============================================================================
# Vanilla Moded World — .gitignore
# Excludes development scraps, reference sheets, raw textures, and cache files
# ==============================================================================

# Raw reference textures, templates, and reference images
references/raw_textures/
tools/vanilla/
*.jpg
*.jpeg
*.webp
*.psd
*.ase
*.aseprite

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.cpython-*.pyc
.venv/
venv/
env/

# Operating System files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor and IDE metadata
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs, crash dumps & temporary output
*.log
crash_*.txt
*.tmp
*.bak

tools/scratch/

